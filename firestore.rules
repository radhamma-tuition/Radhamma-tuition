rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /teachers/{id}  { allow read: if true; allow write: if false; }
    match /students/{id}  { allow read, create, update: if true; allow delete: if false; }
    match /attendance/{id}{ allow read, write: if true; }
    match /marks/{id}     { allow read, write: if true; }
    match /fees/{id}      { allow read, write: if true; }
    match /notifications/{id}{ allow read, write: if true; }
    match /feedback/{id}  { allow read, write: if true; }
  }
}
